pipeline {
    agent { label 'test' }

    triggers {
        githubPush()
    }

    stages {
        stage('Deploy') {
            steps {
                sh '''
                echo "Running on: $(hostname)"
                pwd
                ls -la

                mkdir -p /opt/test-app
                cp -rv * /opt/test-app/

                echo "Files in target folder:"
                ls -la /opt/test-app
                '''
            }
        }
    }
}
`
