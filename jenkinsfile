pipeline {
    agent { label 'test' }

    triggers {
        githubPush()
    }

    stages {
        stage('Deploy') {
            steps {
                sh '''
                    echo "Current Workspace:"
                    pwd

                    echo "Workspace Files:"
                    ls -la

                    mkdir -p /opt/test-app
                    cp -rv * /opt/test-app/

                    echo "Files in Test App:"
                    ls -la /opt/test-app
                '''
            }
        }
    }
}
