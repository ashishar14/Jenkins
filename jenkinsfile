pipeline {
    agent { label 'test' }

    triggers {
        githubPush()
    }

    stages {
        stage('Deploy') {
            steps {
                sh '''
                echo "Workspace Files:"
                ls -la

                cp -rv * /opt/test-app/

                echo "Files copied:"
                ls -la /opt/test-app
                '''
            }
        }
    }
}
