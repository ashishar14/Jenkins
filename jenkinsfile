pipeline {

    agent none

    triggers {
        githubPush()
    }

    stages {

        stage('Deploy To Test') {

            agent { label 'test' }

            steps {

                sh '''
                rm -rf /opt/test-app/*
                cp -r * /opt/test-app/
                '''

            }
        }

        stage('Verify Test Deployment') {

            agent { label 'test' }

            steps {

                sh '''
                echo "Files on Test Server:"
                ls -la /opt/test-app
                '''

            }
        }

        stage('Deploy To Production') {

            agent { label 'prod' }

            steps {

                sh '''
                rm -rf /opt/prod-app/*
                cp -r * /opt/prod-app/
                '''

            }
        }

        stage('Verify Production Deployment') {

            agent { label 'prod' }

            steps {

                sh '''
                echo "Files on Prod Server:"
                ls -la /opt/prod-app
                '''

            }
        }
    }
}
