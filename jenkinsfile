pipeline {
    agent { label 'prod' }

    stages {
        stage('Deploy') {
            steps {
                sh '''
                mkdir -p /opt/prod-app
                cp -r ${WORKSPACE}/* /opt/prod-app/
                '''
            }
        }

        stage('Verify') {
            steps {
                sh 'ls -la /opt/prod-app'
            }
        }
    }
}
