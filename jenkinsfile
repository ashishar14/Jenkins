pipeline {
    agent { label 'test' }

    stages {

        stage('Verify Node') {
            steps {
                sh '''
                echo "Running on Test Node"
                hostname
                pwd
                '''
            }
        }

        stage('Deploy Files') {
            steps {
                sh '''
                mkdir -p /opt/test-app

                cp -r * /opt/test-app/
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                ls -la /opt/test-app
                '''
            }
        }

    }
}
