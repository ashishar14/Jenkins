pipeline {
    agent { label 'test' }

    triggers {
        githubPush()
    }

    stages {
        stage('Deploy') {
            steps {
                sh '''
                    echo "=== DEBUG ==="
                    hostname
                    hostname -I
                    whoami
                    pwd

                    ls -ld /opt
                    ls -ld /opt/test-app || echo "TEST-APP NOT FOUND"

                    cp -rv * /opt/test-app/

                    echo "Deployment Complete"
                    ls -la /opt/test-app
                '''
            }
        }
    }
}
