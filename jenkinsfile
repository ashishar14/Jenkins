pipeline {
    agent { label 'prod' }

    triggers {
        githubPush()
    }

    stages {
        stage('Deploy') {
            steps {
                sh '''
                    echo "Running on:"
                    hostname

                    echo "Workspace Files:"
                    ls -la

                    ls -ld /opt/prod-app

                    cp -rv * /opt/prod-app/

                    echo "Deployment Complete"
                    ls -la /opt/prod-app
                '''
            }
        }
    }
}
